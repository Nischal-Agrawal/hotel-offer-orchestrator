{
  "info": {
    "_postman_id": "7f8b9e6a-5432-4d1e-8a0a-123456789abc",
    "name": "Hotel Offer Orchestrator",
    "description": "Production-grade automated test collection for the Hotel Offer Orchestrator system, covering Health checks, Supplier mocking, Temporal deduplication, Redis range indexing, and Chaos resilience.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & Suppliers",
      "item": [
        {
          "name": "Deep System Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK or 503', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 503]);",
                  "});",
                  "pm.test('Response contains valid health structure', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('status');",
                  "    pm.expect(json).to.have.property('dependencies');",
                  "    pm.expect(json.dependencies).to.have.property('redis');",
                  "    pm.expect(json.dependencies).to.have.property('temporal');",
                  "    pm.expect(json.dependencies).to.have.property('supplierA');",
                  "    pm.expect(json.dependencies).to.have.property('supplierB');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Mock Supplier A - Delhi Hotels",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/supplierA/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["supplierA", "hotels"],
              "query": [{ "key": "city", "value": "delhi" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns array of Supplier A hotels in Delhi', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "    pm.expect(data.length).to.be.greaterThan(0);",
                  "    pm.expect(data[0]).to.have.property('hotelId');",
                  "    pm.expect(data[0]).to.have.property('name');",
                  "    pm.expect(data[0]).to.have.property('price');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Mock Supplier B - Delhi Hotels",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/supplierB/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["supplierB", "hotels"],
              "query": [{ "key": "city", "value": "delhi" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns array of Supplier B hotels in Delhi', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "    pm.expect(data.length).to.be.greaterThan(0);",
                  "    pm.expect(data[0]).to.have.property('hotelId');",
                  "    pm.expect(data[0]).to.have.property('commissionPct');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Hotel Search & Deduplication",
      "item": [
        {
          "name": "Search Delhi Hotels (Deduplication Verification)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [{ "key": "city", "value": "delhi" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is a top-level JSON array', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "});",
                  "pm.test('Holtin selected from Supplier B at 5340', function () {",
                  "    var data = pm.response.json();",
                  "    var holtin = data.find(function(h) { return h.name.toLowerCase() === 'holtin'; });",
                  "    pm.expect(holtin).to.exist;",
                  "    pm.expect(holtin.price).to.eql(5340);",
                  "    pm.expect(holtin.supplier).to.eql('Supplier B');",
                  "});",
                  "pm.test('Radison selected from Supplier A at 5900', function () {",
                  "    var data = pm.response.json();",
                  "    var radison = data.find(function(h) { return h.name.toLowerCase() === 'radison'; });",
                  "    pm.expect(radison).to.exist;",
                  "    pm.expect(radison.price).to.eql(5900);",
                  "    pm.expect(radison.supplier).to.eql('Supplier A');",
                  "});",
                  "pm.test('No duplicate hotel names exist', function () {",
                  "    var data = pm.response.json();",
                  "    var names = data.map(function(h) { return h.name.toLowerCase(); });",
                  "    var uniqueNames = new Set(names);",
                  "    pm.expect(names.length).to.eql(uniqueNames.size);",
                  "});",
                  "pm.test('Required response headers present', function () {",
                  "    pm.expect(pm.response.headers.get('X-Request-Id')).to.exist;",
                  "    pm.expect(pm.response.headers.get('X-Cache-Status')).to.be.oneOf(['HIT', 'MISS']);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Search Mumbai Hotels (Multi-city Isolation)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=mumbai",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [{ "key": "city", "value": "mumbai" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns Mumbai hotels only', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "    pm.expect(data.length).to.be.greaterThan(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Search Non-existent City (Empty Results)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=unknowncity",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [{ "key": "city", "value": "unknowncity" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns empty array []', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array').that.is.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Redis Price Range Filtering",
      "item": [
        {
          "name": "Filter by Price Range (5000 to 6000)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=5000&maxPrice=6000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "delhi" },
                { "key": "minPrice", "value": "5000" },
                { "key": "maxPrice", "value": "6000" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('All returned hotels within price range [5000, 6000]', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "    data.forEach(function(hotel) {",
                  "        pm.expect(hotel.price).to.be.at.least(5000);",
                  "        pm.expect(hotel.price).to.be.at.most(6000);",
                  "    });",
                  "});",
                  "pm.test('X-Cache-Status header indicates cache usage', function () {",
                  "    pm.expect(pm.response.headers.get('X-Cache-Status')).to.be.oneOf(['HIT', 'MISS']);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Filter by Minimum Price Only (>= 6000)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=6000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "delhi" },
                { "key": "minPrice", "value": "6000" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('All returned hotels have price >= 6000', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "    data.forEach(function(hotel) {",
                  "        pm.expect(hotel.price).to.be.at.least(6000);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Filter by Maximum Price Only (<= 5500)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&maxPrice=5500",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "delhi" },
                { "key": "maxPrice", "value": "5500" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('All returned hotels have price <= 5500', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "    data.forEach(function(hotel) {",
                  "        pm.expect(hotel.price).to.be.at.most(5500);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Invalid Price Range (minPrice > maxPrice) -> 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=9000&maxPrice=3000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "delhi" },
                { "key": "minPrice", "value": "9000" },
                { "key": "maxPrice", "value": "3000" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Response body describes validation error', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.eql('Validation Error');",
                  "    pm.expect(json.details[0].message).to.include('minPrice');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Resilience & Failure Simulation",
      "item": [
        {
          "name": "Inject Outage into Supplier A",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"healthy\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/suppliers/supplierA/status",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "suppliers", "supplierA", "status"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Supplier A reported as unhealthy', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.healthy).to.be.false;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Verify Degraded Health Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Health check returns 200 degraded', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('degraded');",
                  "    pm.expect(json.dependencies.supplierA.status).to.eql('down');",
                  "    pm.expect(json.dependencies.supplierB.status).to.eql('up');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Search With Refresh (Graceful Supplier Fallback)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&refresh=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "delhi" },
                { "key": "refresh", "value": "true" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('X-Degraded-Suppliers header indicates Supplier A failure', function () {",
                  "    pm.expect(pm.response.headers.get('X-Degraded-Suppliers')).to.include('Supplier A');",
                  "});",
                  "pm.test('All returned offers originate from healthy Supplier B', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "    pm.expect(data.length).to.be.greaterThan(0);",
                  "    data.forEach(function(hotel) {",
                  "        pm.expect(hotel.supplier).to.eql('Supplier B');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Restore Supplier A Health",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"healthy\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/suppliers/supplierA/status",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "suppliers", "supplierA", "status"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Supplier A restored to healthy', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.healthy).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
